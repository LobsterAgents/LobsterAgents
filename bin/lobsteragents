#!/usr/bin/env bash
set -euo pipefail

SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT_TARGET="$(readlink "$SCRIPT")"
  [[ "$SCRIPT_TARGET" != /* ]] && SCRIPT_TARGET="$SCRIPT_DIR/$SCRIPT_TARGET"
  SCRIPT="$SCRIPT_TARGET"
done
ROOT="$(cd -P "$(dirname "$SCRIPT")/.." && pwd)"
OPENCLAW_HOME="${OPENCLAW_HOME:-$HOME/.openclaw}"
DATA_HOME="${LOBSTERAGENTS_DATA_HOME:-$HOME/Data/lobsteragents}"
CONFIG_PATH="${OPENCLAW_CONFIG:-$OPENCLAW_HOME/openclaw.json}"
WORKSPACE_SKILLS_DIR="${OPENCLAW_WORKSPACE_SKILLS_DIR:-$OPENCLAW_HOME/workspace/skills}"
MANIFEST="$ROOT/manifests/agents.json"

usage() {
  printf '%s\n' \
    'lobsteragents - LobsterAgents installer for OpenClaw' \
    '' \
    'Usage:' \
    '  lobsteragents install           Install or update the LobsterAgents roster' \
    '  lobsteragents models list       Show models found in OpenClaw config' \
    '  lobsteragents models [models]   Set models for installed LobsterAgents' \
    '  lobsteragents connect [agent]   Connect an existing OpenClaw agent as liaison' \
    '  lobsteragents disconnect [agent] Remove liaison wiring from an OpenClaw agent' \
    '  lobsteragents doctor            Validate files and OpenClaw config' \
    '  lobsteragents list              Print the Lobster Agents roster' \
    '  lobsteragents uninstall         Remove Lobster agent config entries, keep data/backups' \
    '' \
    'Environment:' \
    '  OPENCLAW_HOME              Default: $HOME/.openclaw' \
    '  LOBSTERAGENTS_DATA_HOME    Default: $HOME/Data/lobsteragents' \
    '  LOBSTERAGENTS_STRATEGIC_MODEL / STANDARD_MODEL / LOCAL_MODEL' \
    '' \
    'Examples:' \
    '  lobsteragents connect main' \
    '  lobsteragents connect bob' \
    '  lobsteragents models openai/gpt-5.5 vllm/qwen3.6-fp8 vllm/qwen3.6-fp8'
}

need_file() {
  if [[ ! -f "$1" ]]; then echo "ERROR: missing $1" >&2; exit 1; fi
}

backup_config() {
  mkdir -p "$OPENCLAW_HOME/backups"
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)"
  cp "$CONFIG_PATH" "$OPENCLAW_HOME/backups/openclaw.lobsteragents.$stamp.$$.json"
  echo "$OPENCLAW_HOME/backups/openclaw.lobsteragents.$stamp.$$.json"
}

install_files() {
  mkdir -p "$DATA_HOME" "$WORKSPACE_SKILLS_DIR"
  rsync -a --delete --exclude='.DS_Store' "$ROOT/agents" "$DATA_HOME/"
  rsync -a --delete --exclude='.DS_Store' "$ROOT/templates" "$DATA_HOME/"
  rsync -a --delete --exclude='.DS_Store' "$ROOT/processes" "$DATA_HOME/" 2>/dev/null || true
  rsync -a --delete --exclude='.DS_Store' "$ROOT/assets" "$DATA_HOME/" 2>/dev/null || true
  cp "$ROOT/MASTER-PLAN.md" "$DATA_HOME/MASTER-PLAN.md"
  cp "$ROOT/LOBSTER-AGENTS.md" "$DATA_HOME/README.md"
  rsync -a --delete --exclude='.DS_Store' "$ROOT/skills/lobster-orchestrator" "$WORKSPACE_SKILLS_DIR/"
}

patch_config() {
  need_file "$CONFIG_PATH"; need_file "$MANIFEST"
  python3 - "$CONFIG_PATH" "$MANIFEST" "$DATA_HOME" <<'PY'
import json, os, sys
from pathlib import Path
config_path = Path(sys.argv[1])
manifest_path = Path(sys.argv[2])
data_home = Path(sys.argv[3]).expanduser()
openclaw_home = Path(os.environ.get('OPENCLAW_HOME', str(Path.home() / '.openclaw'))).expanduser()
cfg = json.loads(config_path.read_text())
manifest = json.loads(manifest_path.read_text())
tiers = manifest['modelTiers']
for tier, env in [('strategic','LOBSTERAGENTS_STRATEGIC_MODEL'),('standard','LOBSTERAGENTS_STANDARD_MODEL'),('local','LOBSTERAGENTS_LOCAL_MODEL')]:
    if os.environ.get(env): tiers[tier]['primary'] = os.environ[env]
agents_cfg = cfg.setdefault('agents', {})
agents_list = agents_cfg.setdefault('list', [])
by_id = {a.get('id'): a for a in agents_list if isinstance(a, dict) and a.get('id')}
all_ids = [a['id'] for a in manifest['agents']]
for agent in manifest['agents']:
    agent_id = agent['id']; tier = tiers[agent.get('modelTier','standard')]
    entry = by_id.get(agent_id, {'id': agent_id})
    entry.update({'id': agent_id, 'name': agent_id, 'workspace': str(data_home / 'workspaces' / agent_id), 'agentDir': str(openclaw_home / 'agents' / agent_id / 'agent'), 'model': {'primary': tier['primary'], 'fallbacks': tier.get('fallbacks', [])}})
    if agent_id not in by_id: agents_list.append(entry); by_id[agent_id] = entry
config_path.write_text(json.dumps(cfg, indent=2) + '\n')
print(f'Patched {config_path}')
print(f'Installed {len(all_ids)} Lobster agents into OpenClaw config')
print('No liaison agent was modified. Run: lobsteragents connect main')
PY
}

create_workspaces() {
  need_file "$MANIFEST"
  python3 - "$MANIFEST" "$DATA_HOME" <<'PY'
import json, re, sys
from pathlib import Path
manifest = json.loads(Path(sys.argv[1]).read_text())
data_home = Path(sys.argv[2]).expanduser()
profiles = data_home / 'agents'; workspaces = data_home / 'workspaces'
workspaces.mkdir(parents=True, exist_ok=True)
def extract_prompt(text):
    ticks = chr(96) * 3
    match = re.search(r'## SYSTEM PROMPT\s*' + re.escape(ticks) + r'\s*(.*?)' + re.escape(ticks), text, re.S)
    return match.group(1).strip() if match else ''
for agent in manifest['agents']:
    agent_id = agent['id']; workspace = workspaces / agent_id
    (workspace / 'memory').mkdir(parents=True, exist_ok=True)
    profile_path = profiles / f'{agent_id}.md'
    profile_text = profile_path.read_text() if profile_path.exists() else ''
    prompt = extract_prompt(profile_text)
    soul = workspace / 'SOUL.md'
    if prompt and not soul.exists(): soul.write_text(f'# SOUL.md\n\n{prompt}\n')
    (workspace / 'AGENTS.md').write_text(f"""# AGENTS.md - {agent['name']} Workspace\n\nYou are {agent['name']}, {agent['role']} at Lobster Agents LLC.\n\n## References\n\n- Company plan: {data_home}/MASTER-PLAN.md\n- Your profile: {data_home}/agents/{agent_id}.md\n- Project files: ~/Data/[project]/\n- Source code: ~/Source/[project]/\n\n## Working Rules\n\n- Work inside your assigned task and report concise results.\n- Do not overwrite another agent's work without explicit instruction.\n- Log durable notes in memory/YYYY-MM-DD.md when useful.\n""")
print(f"Created/updated workspaces for {len(manifest['agents'])} agents")
PY
}

install_cmd() {
  if [[ ! -f "$CONFIG_PATH" ]]; then echo "ERROR: OpenClaw config not found at $CONFIG_PATH" >&2; exit 1; fi
  echo 'Installing LobsterAgents roster...'
  local backup; backup="$(backup_config)"; echo "Backed up OpenClaw config: $backup"
  install_files; create_workspaces; patch_config
  echo; echo 'lobsteragents install complete.'; echo 'Run: lobsteragents connect main'; echo 'Run: lobsteragents doctor'
}

doctor_cmd() {
  need_file "$MANIFEST"
  python3 - "$CONFIG_PATH" "$MANIFEST" "$DATA_HOME" "$WORKSPACE_SKILLS_DIR" <<'PY'
import json, sys
from pathlib import Path
config_path, manifest_path, data_home, skills_dir = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3]).expanduser(), Path(sys.argv[4]).expanduser()
errors=[]; warnings=[]; manifest=json.loads(manifest_path.read_text())
if not config_path.exists(): errors.append(f'Missing OpenClaw config: {config_path}'); cfg={}
else:
    try: cfg=json.loads(config_path.read_text())
    except Exception as exc: errors.append(f'Invalid JSON config: {exc}'); cfg={}
ids=[a['id'] for a in manifest['agents']]
for agent_id in ids:
    if not (data_home/'agents'/f'{agent_id}.md').exists(): errors.append(f'Missing profile for {agent_id}')
    if not (data_home/'workspaces'/agent_id/'AGENTS.md').exists(): warnings.append(f'Missing workspace AGENTS.md for {agent_id}')
skill=skills_dir/'lobster-orchestrator'/'SKILL.md'
if not skill.exists(): errors.append(f'Missing lobster-orchestrator skill: {skill}')
configured={a.get('id') for a in cfg.get('agents',{}).get('list',[]) if isinstance(a,dict)}
missing=[agent_id for agent_id in ids if agent_id not in configured]
if missing: errors.append('Agents missing from OpenClaw config: '+', '.join(missing))
print('lobsteragents doctor')
print(f'- package agents: {len(ids)}')
print(f'- data home: {data_home}')
print(f'- config: {config_path}')
print(f'- orchestrator skill: {skill}')
if warnings: print('\nWarnings:'); [print(f'- {x}') for x in warnings]
if errors:
    print('\nErrors:'); [print(f'- {x}') for x in errors]; sys.exit(1)
print('\nOK: LobsterAgents is installed.')
PY
}

list_cmd() {
  need_file "$MANIFEST"
  python3 - "$MANIFEST" <<'PY'
import json, sys
from pathlib import Path
for a in json.loads(Path(sys.argv[1]).read_text())['agents']:
    print(f"{a['id']}: {a['name']} - {a['role']} ({a['department']})")
PY
}

models_cmd() {
  need_file "$CONFIG_PATH"; need_file "$MANIFEST"
  local strategic="${1:-}"
  local standard="${2:-}"
  local local_model="${3:-}"

  if [[ "$strategic" == "list" || "$strategic" == "--list" ]]; then
    python3 - "$CONFIG_PATH" <<'PY'
import json, sys
from pathlib import Path

cfg = json.loads(Path(sys.argv[1]).read_text())
seen = set()
models = []

def add(value, source):
    if isinstance(value, str) and value and value not in seen:
        seen.add(value)
        models.append((value, source))

for provider, pcfg in cfg.get("models", {}).get("providers", {}).items():
    if isinstance(pcfg, dict):
        for model in pcfg.get("models", []) or []:
            if isinstance(model, dict) and model.get("id"):
                add(f"{provider}/{model['id']}", "provider")

for agent in cfg.get("agents", {}).get("list", []) or []:
    if not isinstance(agent, dict):
        continue
    model = agent.get("model")
    if not isinstance(model, dict):
        continue
    add(model.get("primary"), f"agent:{agent.get('id', 'unknown')}")
    for fallback in model.get("fallbacks", []) or []:
        add(fallback, f"agent:{agent.get('id', 'unknown')}")

for idx, (model, source) in enumerate(models, 1):
    print(f"{idx}. {model} ({source})")
if not models:
    print("No models found in OpenClaw config.")
PY
    return
  fi

  local backup; backup="$(backup_config)"
  python3 - "$CONFIG_PATH" "$MANIFEST" "$strategic" "$standard" "$local_model" <<'PY'
import json, sys
from pathlib import Path

config_path = Path(sys.argv[1])
manifest_path = Path(sys.argv[2])
strategic_arg, standard_arg, local_arg = sys.argv[3], sys.argv[4], sys.argv[5]
cfg = json.loads(config_path.read_text())
manifest = json.loads(manifest_path.read_text())

seen = set()
available = []

def add(value, source):
    if isinstance(value, str) and value and value not in seen:
        seen.add(value)
        available.append((value, source))

for provider, pcfg in cfg.get("models", {}).get("providers", {}).items():
    if isinstance(pcfg, dict):
        for model in pcfg.get("models", []) or []:
            if isinstance(model, dict) and model.get("id"):
                add(f"{provider}/{model['id']}", "provider")

for agent in cfg.get("agents", {}).get("list", []) or []:
    if not isinstance(agent, dict):
        continue
    model = agent.get("model")
    if not isinstance(model, dict):
        continue
    add(model.get("primary"), f"agent:{agent.get('id', 'unknown')}")
    for fallback in model.get("fallbacks", []) or []:
        add(fallback, f"agent:{agent.get('id', 'unknown')}")

def resolve(value):
    value = (value or "").strip()
    if not value:
        return ""
    if value.isdigit():
        idx = int(value)
        if 1 <= idx <= len(available):
            return available[idx - 1][0]
    return value

def preferred_index(kind):
    for idx, (model, _) in enumerate(available, 1):
        lower = model.lower()
        if kind == "strategic" and ("gpt" in lower or "claude" in lower or "opus" in lower):
            return idx
        if kind in ("standard", "local") and ("vllm" in lower or "ollama" in lower or "qwen" in lower):
            return idx
    return 1 if available else None

def pick(kind, supplied):
    resolved = resolve(supplied)
    if resolved:
        return resolved
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("Usage: lobsteragents models <strategic-model> <standard-model> [local-model]", file=sys.stderr)
        print("Run `lobsteragents models list` to show configured OpenClaw models.", file=sys.stderr)
        sys.exit(2)
    if not available:
        return input(f"{kind.title()} model: ").strip()
    print(f"\nChoose {kind} model:")
    for idx, (model, source) in enumerate(available, 1):
        print(f"  {idx}) {model} [{source}]")
    default_idx = preferred_index(kind)
    default_text = f" [{default_idx}]" if default_idx else ""
    choice = input(f"{kind.title()} model number or id{default_text}: ").strip()
    if not choice and default_idx:
        return available[default_idx - 1][0]
    return resolve(choice)

strategic = pick("strategic", strategic_arg)
standard = pick("standard", standard_arg)
local = resolve(local_arg)
if not local:
    if sys.stdin.isatty() and sys.stdout.isatty():
        choice = input(f"Local model number or id [same as standard: {standard}]: ").strip()
        local = resolve(choice) if choice else standard
    else:
        local = standard

models = {"strategic": strategic, "standard": standard, "local": local}
agents = cfg.get("agents", {}).get("list", [])
by_id = {a.get("id"): a for a in agents if isinstance(a, dict) and a.get("id")}
updated = []
for agent in manifest["agents"]:
    agent_id = agent["id"]
    entry = by_id.get(agent_id)
    if not entry:
        continue
    tier_name = agent.get("modelTier", "standard")
    model = models.get(tier_name) or models["standard"]
    if not model:
        continue
    model_cfg = entry.setdefault("model", {})
    model_cfg["primary"] = model
    updated.append((agent_id, tier_name, model))
config_path.write_text(json.dumps(cfg, indent=2) + "\n")
print(f"Updated models for {len(updated)} LobsterAgents")
for tier_name in ("strategic", "standard", "local"):
    count = sum(1 for _, t, _ in updated if t == tier_name)
    if count:
        print(f"- {tier_name}: {models[tier_name]} ({count} agents)")
PY
  echo "Backed up previous config: $backup"
}

connect_cmd() {
  need_file "$CONFIG_PATH"; need_file "$MANIFEST"
  local liaison="${1:-main}"
  local backup; backup="$(backup_config)"
  python3 - "$CONFIG_PATH" "$MANIFEST" "$DATA_HOME" "$OPENCLAW_HOME" "$liaison" <<'PY'
import json, sys
from pathlib import Path
config_path = Path(sys.argv[1])
manifest_path = Path(sys.argv[2])
data_home = Path(sys.argv[3]).expanduser()
openclaw_home = Path(sys.argv[4]).expanduser()
liaison_id = sys.argv[5]
cfg = json.loads(config_path.read_text())
manifest = json.loads(manifest_path.read_text())
lobster_ids = [a["id"] for a in manifest["agents"]]
agents_cfg = cfg.setdefault("agents", {})
agents_list = agents_cfg.setdefault("list", [])
by_id = {a.get("id"): a for a in agents_list if isinstance(a, dict) and a.get("id")}
liaison = by_id.get(liaison_id)
if liaison is None:
    print(f"ERROR: OpenClaw agent not found: {liaison_id}", file=sys.stderr)
    print("Run `openclaw` setup first or choose an existing agent id.", file=sys.stderr)
    sys.exit(1)
allow = liaison.setdefault("subagents", {}).setdefault("allowAgents", [])
for agent_id in lobster_ids:
    if agent_id not in allow:
        allow.append(agent_id)
workspace = Path(liaison.get("workspace") or (openclaw_home / "workspace" if liaison_id == "main" else data_home / "workspaces" / liaison_id)).expanduser()
workspace.mkdir(parents=True, exist_ok=True)
agents_md = workspace / "AGENTS.md"
start = "<!-- lobsteragents:start -->"
end = "<!-- lobsteragents:end -->"
block = f"""{start}
## LobsterAgents Liaison

You are connected as the liaison between the user and the installed LobsterAgents company.
When the user asks for @company, LobsterAgents, company work, departments, named Lobster agents, or agent delegation, use the installed LobsterAgents roster and the lobster-orchestrator skill.

Do not replace your normal assistant identity. Treat LobsterAgents as an available company/team you can coordinate when useful.

Installed roster data: {data_home}
Orchestrator skill: {openclaw_home / "workspace" / "skills" / "lobster-orchestrator" / "SKILL.md"}
{end}
"""
existing = agents_md.read_text() if agents_md.exists() else ""
if start in existing and end in existing:
    before = existing.split(start, 1)[0].rstrip()
    after = existing.split(end, 1)[1].lstrip()
    new_text = before + "\n\n" + block + ("\n\n" + after if after else "\n")
else:
    new_text = existing.rstrip() + ("\n\n" if existing.strip() else "") + block
agents_md.write_text(new_text)
config_path.write_text(json.dumps(cfg, indent=2) + "\n")
print(f"Connected {liaison_id} as LobsterAgents liaison")
print(f"Updated OpenClaw config: {config_path}")
print(f"Updated liaison instructions: {agents_md}")
print(f"Allowed {len(lobster_ids)} LobsterAgents subagents")
PY
  echo "Backed up previous config: $backup"
}

disconnect_cmd() {
  need_file "$CONFIG_PATH"; need_file "$MANIFEST"
  local liaison="${1:-main}"
  local backup; backup="$(backup_config)"
  python3 - "$CONFIG_PATH" "$MANIFEST" "$DATA_HOME" "$OPENCLAW_HOME" "$liaison" <<'PY'
import json, sys
from pathlib import Path
config_path = Path(sys.argv[1])
manifest_path = Path(sys.argv[2])
data_home = Path(sys.argv[3]).expanduser()
openclaw_home = Path(sys.argv[4]).expanduser()
liaison_id = sys.argv[5]
cfg = json.loads(config_path.read_text())
manifest = json.loads(manifest_path.read_text())
lobster_ids = {a["id"] for a in manifest["agents"]}
agents_list = cfg.get("agents", {}).get("list", [])
by_id = {a.get("id"): a for a in agents_list if isinstance(a, dict) and a.get("id")}
liaison = by_id.get(liaison_id)
if liaison is None:
    print(f"ERROR: OpenClaw agent not found: {liaison_id}", file=sys.stderr)
    sys.exit(1)
allow = liaison.get("subagents", {}).get("allowAgents")
if isinstance(allow, list):
    liaison["subagents"]["allowAgents"] = [x for x in allow if x not in lobster_ids]
workspace = Path(liaison.get("workspace") or (openclaw_home / "workspace" if liaison_id == "main" else data_home / "workspaces" / liaison_id)).expanduser()
agents_md = workspace / "AGENTS.md"
start = "<!-- lobsteragents:start -->"
end = "<!-- lobsteragents:end -->"
if agents_md.exists():
    existing = agents_md.read_text()
    if start in existing and end in existing:
        before = existing.split(start, 1)[0].rstrip()
        after = existing.split(end, 1)[1].lstrip()
        agents_md.write_text(before + ("\n\n" + after if after else "\n"))
config_path.write_text(json.dumps(cfg, indent=2) + "\n")
print(f"Disconnected {liaison_id} from LobsterAgents liaison wiring")
print(f"Updated OpenClaw config: {config_path}")
if agents_md.exists(): print(f"Updated liaison instructions: {agents_md}")
PY
  echo "Backed up previous config: $backup"
}

uninstall_cmd() {
  need_file "$CONFIG_PATH"; need_file "$MANIFEST"
  local backup; backup="$(backup_config)"
  python3 - "$CONFIG_PATH" "$MANIFEST" <<'PY'
import json, sys
from pathlib import Path
config_path=Path(sys.argv[1]); manifest=json.loads(Path(sys.argv[2]).read_text()); ids={a['id'] for a in manifest['agents']}
cfg=json.loads(config_path.read_text()); agents_cfg=cfg.get('agents', {})
agents_cfg['list']=[a for a in agents_cfg.get('list', []) if not (isinstance(a,dict) and a.get('id') in ids)]
for a in agents_cfg.get('list', []):
    if isinstance(a,dict):
        allow=a.get('subagents',{}).get('allowAgents')
        if isinstance(allow,list): a['subagents']['allowAgents']=[x for x in allow if x not in ids]
config_path.write_text(json.dumps(cfg, indent=2)+'\n')
print(f'Removed {len(ids)} Lobster agent config entries')
PY
  echo "Backed up previous config: $backup"; echo "Data files were left in place: $DATA_HOME"
}

cmd="${1:-}"
case "$cmd" in
  install) install_cmd ;;
  models) models_cmd "${2:-}" "${3:-}" "${4:-}" ;;
  connect) connect_cmd "${2:-main}" ;;
  disconnect) disconnect_cmd "${2:-main}" ;;
  doctor) doctor_cmd ;;
  list) list_cmd ;;
  uninstall) uninstall_cmd ;;
  -h|--help|help|'') usage ;;
  *) echo "ERROR: unknown command: $cmd" >&2; usage; exit 2 ;;
esac
